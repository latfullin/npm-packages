# Скопируйте в .env, если нужно отойти от значения по умолчанию: cp .env.example .env
# Обычно править нечего: домены и сертификаты настраиваются в проекте ../proxy.

# Что слушает Caddy внутри контейнера. :80 — http внутрь сети web, за прокси.
# Домен здесь указывать не нужно — Caddy тогда сам полезет за сертификатом
# и будет конфликтовать с прокси за порт 443.
SITE_ADDRESS=:80

# Номер счётчика Яндекс.Метрики. Пусто или строка закомментирована — метрики на сайте нет.
# Счётчик статический и вшивается при сборке образа, поэтому после изменения нужен
# docker compose up -d --build.
# METRIKA_ID=113980930
