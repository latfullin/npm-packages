{
  "name": "holidays-api",
  "private": true,
  "description": "API праздников и рабочих дней по странам, производственный календарь РФ",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "dev": "tsc && concurrently -k \"tsc -w --preserveWatchOutput\" \"node --watch dist/server.js\"",
    "test": "npm run build && node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "date-holidays": "^3.37.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.1"
  }
}
