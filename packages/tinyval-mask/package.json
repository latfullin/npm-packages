{
  "name": "tinyval-mask",
  "version": "0.1.0",
  "description": "Tiny zero-dependency input masks: phones, cards, dates, numbers, documents, custom patterns",
  "homepage": "https://tinyval.ru/tinyval-mask/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latfullin/npm-packages.git",
    "directory": "packages/tinyval-mask"
  },
  "bugs": "https://github.com/latfullin/npm-packages/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "npm run build && tsc -p test && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mask",
    "input mask",
    "phone mask",
    "number format",
    "zero-dependency"
  ],
  "author": "kilkenny",
  "license": "MIT",
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  }
}
