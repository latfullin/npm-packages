{
  "name": "tinyval-vue",
  "version": "0.1.0",
  "description": "Vue 3 form state for tinyval: v-model values, errors, touched, submit, server errors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "tinyval": "^0.1.0",
    "vue": "^3.3.0"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "npm run build && tsc -p test && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "vue",
    "form",
    "validation",
    "tinyval",
    "composable"
  ],
  "author": "kilkenny",
  "license": "MIT",
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "tinyval": "*",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  }
}
