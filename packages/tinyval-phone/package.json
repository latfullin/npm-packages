{
  "name": "tinyval-phone",
  "version": "0.1.1",
  "description": "Phone masks for every country for tinyval-mask: country detection, formats, SVG flag icons",
  "author": "kilkenny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latfullin/npm-packages.git",
    "directory": "packages/tinyval-phone"
  },
  "homepage": "https://tinyval.ru/tinyval-phone/",
  "bugs": "https://github.com/latfullin/npm-packages/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tinyval-phone": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./flags": {
      "types": "./dist/flag-icons.d.ts",
      "default": "./dist/flag-icons.js"
    },
    "./flags/*.svg": "./flags/*.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "flags",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "tinyval-mask": "^0.1.1"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "rm -rf dist .tsbuildinfo && node scripts/flags.mjs && tsc",
    "dev": "node scripts/flags.mjs && tsc --watch",
    "test": "npm run build && tsc -p test && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "phone",
    "phone mask",
    "phone number",
    "country flags",
    "tinyval-mask"
  ],
  "devDependencies": {
    "@types/node": "^24.19.1",
    "country-flag-icons": "^1.6.20",
    "libphonenumber-js": "^1.13.14",
    "tinyval-mask": "*",
    "typescript": "^7.0.2"
  }
}
