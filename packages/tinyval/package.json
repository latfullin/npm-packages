{
  "name": "tinyval",
  "version": "0.1.0",
  "description": "Tiny, fast, zero-dependency validation",
  "author": "kilkenny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latfullin/npm-packages.git",
    "directory": "packages/tinyval"
  },
  "homepage": "https://tinyval.ru/tinyval/",
  "bugs": {
    "url": "https://github.com/latfullin/npm-packages/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tinyval": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    },
    "./locales/ru": {
      "types": "./dist/locales/ru.d.ts",
      "default": "./dist/locales/ru.js"
    },
    "./locales/zh": {
      "types": "./dist/locales/zh.d.ts",
      "default": "./dist/locales/zh.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "npm run build && tsc -p test && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "validation",
    "validator",
    "tiny",
    "zero-dependency"
  ],
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
